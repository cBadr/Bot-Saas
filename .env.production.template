# ============================================
# Orca Trading Platform — Production .env
# Domain: orcax.click
# ============================================
# استخدم scripts/generate-env.sh لتوليد هذا تلقائياً بأسرار عشوائية
# أو املأ الـ placeholders الأربعة بنفسك:
#   __DB_PASSWORD__       — كلمة مرور Postgres للمستخدم orca
#   __AUTH_SECRET__       — 64+ حرف عشوائي (openssl rand -base64 64)
#   __ENCRYPTION_SECRET__ — 32+ حرف عشوائي (openssl rand -base64 32)
#   __TELEGRAM_*__        — اختياري (اتركها فارغة لو لا تستخدم Telegram)

NODE_ENV=production

# ──────────────────── Database ────────────────────
DATABASE_URL="postgresql://orca:__DB_PASSWORD__@localhost:5432/orca?schema=public"

# ──────────────────── Redis ────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL="redis://127.0.0.1:6379"

# ──────────────────── API Server (NestJS) ────────────────────
API_PORT=4000
API_HOST=127.0.0.1
API_PREFIX=api/v1
API_CORS_ORIGIN=https://orcax.click

# ──────────────────── Web (Next.js) ────────────────────
# NEXT_PUBLIC_* تُحقن وقت البناء — أي تغيير يتطلب pnpm build
WEB_PORT=3000
NEXT_PUBLIC_API_URL=https://orcax.click/api/v1
NEXT_PUBLIC_WS_URL=wss://orcax.click

# ──────────────────── Engine ────────────────────
ENGINE_PORT=4001
ENGINE_MAX_BOTS_PER_WORKER=10

# ──────────────────── Auth ────────────────────
AUTH_SECRET="__AUTH_SECRET__"
AUTH_URL=https://orcax.click
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ──────────────────── Encryption (Binance API keys at rest) ────────────────────
ENCRYPTION_SECRET="__ENCRYPTION_SECRET__"

# ──────────────────── Binance ────────────────────
BINANCE_BASE_URL=https://api.binance.com
BINANCE_WS_URL=wss://stream.binance.com:9443
BINANCE_TIME_SYNC_INTERVAL_MS=60000
BINANCE_DEFAULT_RECV_WINDOW=5000
BINANCE_REQUESTS_PER_MINUTE=1100
BINANCE_ORDERS_PER_DAY=160000

# ──────────────────── Logging ────────────────────
LOG_LEVEL=info
LOG_PRETTY=false
LOG_FILE_ENABLED=true
LOG_FILE_PATH=./logs

# ──────────────────── Sentry (optional) ────────────────────
SENTRY_DSN=

# ──────────────────── Telegram notifications (optional) ────────────────────
# Bot token من @BotFather، Chat ID من رسالة /start ثم getUpdates API
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=

# ──────────────────── CoinPayments (optional) ────────────────────
COINPAYMENTS_PUBLIC_KEY=
COINPAYMENTS_PRIVATE_KEY=
COINPAYMENTS_IPN_SECRET=
COINPAYMENTS_IPN_URL=https://orcax.click/api/v1/payments/coinpayments/ipn

# ──────────────────── Email via Resend (optional) ────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@orcax.click

# ──────────────────── Web Push (optional — for PWA notifications) ────────────────────
# ولّد VAPID keys: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:admin@orcax.click

# ──────────────────── Discord notifications (optional — per-user webhooks) ────────────────────
# لا يوجد token عام — كل مستخدم يضع webhook URL خاص به في إعداداته
