{
  "name": "orca",
  "version": "0.1.0",
  "private": true,
  "description": "Orca - Professional Crypto Trading SaaS Platform",
  "packageManager": "pnpm@10.6.2",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:generate": "pnpm --filter @orca/db generate",
    "db:migrate": "pnpm --filter @orca/db migrate",
    "db:studio": "pnpm --filter @orca/db studio",
    "db:seed": "pnpm --filter @orca/db seed",
    "start:api": "pnpm --filter @orca/api start:prod",
    "start:engine": "pnpm --filter @orca/engine start:prod",
    "start:web": "pnpm --filter @orca/web start",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:logs": "pm2 logs",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "test:binance": "tsx scripts/test-binance.ts",
    "start:all": "pwsh ./scripts/start-all.ps1",
    "stop:all": "pwsh ./scripts/stop-all.ps1",
    "fresh:build": "pwsh ./scripts/fresh-build.ps1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "dotenv": "^16.4.7",
    "ioredis": "^5.4.2",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  }
}
