// Orca Trading Platform — Prisma Schema
// PostgreSQL 17 + Prisma 6

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────

enum UserRole {
  USER
  PRO
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
  PENDING_VERIFICATION
}

enum ExchangeName {
  BINANCE
}

enum ApiKeyStatus {
  ACTIVE
  DISABLED
  INVALID
}

enum BotStatus {
  CREATED
  STARTING
  RUNNING
  PAUSED
  STOPPING
  STOPPED
  ERROR
}

enum StrategyType {
  GRID
  DCA
  CUSTOM
}

enum StrategyVisibility {
  BUILTIN
  PRIVATE
  PUBLIC
}

enum OrderSide {
  BUY
  SELL
}

enum OrderType {
  LIMIT
  LIMIT_MAKER
}

enum OrderStatus {
  NEW
  PARTIALLY_FILLED
  FILLED
  CANCELED
  PENDING_CANCEL
  REJECTED
  EXPIRED
  EXPIRED_IN_MATCH
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  CONFIRMING
  COMPLETED
  FAILED
  REFUNDED
  CANCELED
}

enum NotificationChannel {
  TELEGRAM
  EMAIL
  DISCORD
  PUSH
  IN_APP
}

enum LogLevel {
  TRACE
  DEBUG
  INFO
  WARN
  ERROR
  FATAL
}

enum LogCategory {
  APP
  TRADE
  API
  BINANCE
  AUDIT
  BOT
  STRATEGY
  PAYMENT
  AUTH
  SYSTEM
}

// ─────────────────────────────────────────────────────
// Users & Auth
// ─────────────────────────────────────────────────────

model User {
  id              String     @id @default(cuid())
  email           String     @unique
  emailVerifiedAt DateTime?
  passwordHash    String
  fullName        String?
  avatarUrl       String?
  role            UserRole   @default(USER)
  status          UserStatus @default(ACTIVE)

  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String?

  telegramChatId  String?
  telegramUsername String?

  /** Discord webhook URL for personal notifications (per-user). */
  discordWebhookUrl String?
  /**
   * Web Push subscriptions (PWA). Array of objects:
   *   { endpoint: string, keys: { p256dh: string, auth: string }, ua?: string, createdAt: string }
   * One user may have multiple devices subscribed.
   */
  pushSubscriptions Json @default("[]")

  // Notification preferences for high-frequency events:
  //   OFF        — never notify on individual fills
  //   PER_CYCLE  — only notify when a complete BUY↔SELL cycle closes (default)
  //   PER_FILL   — notify on every single ladder/grid fill (verbose)
  //   CUSTOM     — apply user-defined rules in `notificationConfig`
  fillFrequency   String  @default("PER_CYCLE")
  /**
   * Free-form JSON for advanced notification rules. Recognized keys:
   *
   *   FILL FILTERS (active only when fillFrequency = 'CUSTOM'):
   *     notifyOnBuyFills?:  boolean (default true)
   *     notifyOnSellFills?: boolean (default true)
   *     minFillNotional?:   number  (skip fills with quote value below this; default 0)
   *     minCyclePnl?:       number  (skip cycle closes with PnL below this; default 0)
   *
   *   PERIODIC STATUS REPORTS:
   *     statusReportIntervalMinutes?: number  (0 / undefined = disabled)
   *     statusReportBots?:            'ALL' | string[]  (default 'ALL')
   */
  notificationConfig Json   @default("{}")
  /** When the last periodic status report was sent. Used by StatusReportService to gate the next send. */
  lastStatusReportAt DateTime?

  referralCode  String? @unique
  referredById  String?
  referredBy    User?   @relation("UserReferrals", fields: [referredById], references: [id])
  referrals     User[]  @relation("UserReferrals")

  /** When the user's 14-day free trial ends. Set at signup. Null = trial converted/skipped. */
  trialEndsAt DateTime?

  lastLoginAt DateTime?
  lastLoginIp String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions       Session[]
  passwordResetTokens PasswordResetToken[]
  apiKeys        ExchangeApiKey[]
  bots           Bot[]
  strategies     Strategy[]
  subscriptions  Subscription[]
  payments       Payment[]
  notifications  NotificationPreference[]
  notificationLogs NotificationLog[]
  auditLogs      AuditLog[]
  systemLogs     SystemLog[]
  couponRedemptions CouponRedemption[]
  surveyResponses   SurveyResponse[]
  approvalRequests  PendingApproval[]  @relation("ApprovalRequester")
  portfolioSnapshots PortfolioSnapshot[]
  priceAlerts        PriceAlert[]

  @@index([role])
  @@index([status])
  @@index([createdAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken String   @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ─────────────────────────────────────────────────────
// Exchange API Keys
// ─────────────────────────────────────────────────────

model ExchangeApiKey {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  exchange    ExchangeName @default(BINANCE)
  label       String
  apiKey      String
  apiSecret   String
  status      ApiKeyStatus @default(ACTIVE)
  permissions Json?
  lastCheckedAt DateTime?
  lastError   String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  bots               Bot[]
  portfolioSnapshots PortfolioSnapshot[]

  @@index([userId])
  @@index([status])
}

// ─────────────────────────────────────────────────────
// Strategies
// ─────────────────────────────────────────────────────

model Strategy {
  id          String             @id @default(cuid())
  ownerId    String?
  owner       User?              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  description String?
  type        StrategyType
  visibility  StrategyVisibility @default(PRIVATE)
  version     Int                @default(1)

  // For built-in strategies: code identifier (e.g., "grid_v1")
  builtinKey String?

  // For custom strategies: visual graph definition (nodes/edges) or JSON config
  definition Json
  // Default parameters schema (zod-like JSON)
  paramsSchema Json?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bots Bot[]

  @@index([ownerId])
  @@index([type])
  @@index([visibility])
  @@unique([builtinKey])
}

// ─────────────────────────────────────────────────────
// Bots
// ─────────────────────────────────────────────────────

model Bot {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiKeyId    String
  apiKey      ExchangeApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Restrict)
  strategyId  String
  strategy    Strategy  @relation(fields: [strategyId], references: [id], onDelete: Restrict)

  name        String
  symbol      String        // e.g., "BTCFDUSD"
  baseAsset   String
  quoteAsset  String

  status      BotStatus     @default(CREATED)

  /// When true, bot runs in simulated mode (no real Binance orders)
  paperTrading Boolean      @default(false)

  /// Auto-stop if daily realized loss exceeds this many quote units (positive number)
  dailyLossLimit Decimal?   @db.Decimal(36, 18)
  /// Auto-stop if drawdown from running peak exceeds this percentage (e.g. 10 = 10%)
  maxDrawdownPct Decimal?   @db.Decimal(10, 6)

  // User-tuned parameters for this bot instance
  params      Json
  // Risk management settings
  riskConfig  Json?

  // Runtime state
  state       Json?
  workerId    String?
  startedAt   DateTime?
  stoppedAt   DateTime?
  lastErrorAt DateTime?
  lastError   String?

  // Aggregated stats (cached for fast dashboard queries)
  totalTrades       Int      @default(0)
  totalVolumeQuote  Decimal  @default(0) @db.Decimal(36, 18)
  realizedPnlQuote  Decimal  @default(0) @db.Decimal(36, 18)
  unrealizedPnlQuote Decimal @default(0) @db.Decimal(36, 18)

  // ─── Run-based lifecycle (a bot is a persistent template; each Start spawns a BotRun) ───
  /** The currently-running session id, null when bot is stopped. */
  currentRunId  String?  @unique
  currentRun    BotRun?  @relation("BotCurrentRun", fields: [currentRunId], references: [id], onDelete: SetNull)
  /** Soft-archive timestamp. Archived bots are hidden from default lists but data is preserved. */
  archivedAt    DateTime?

  // Lifetime aggregates (sum across all runs of this bot). Updated atomically on each run close.
  totalRuns         Int      @default(0)
  lifetimeRealized  Decimal  @default(0) @db.Decimal(36, 18)
  lifetimeCycles    Int      @default(0)
  lifetimeVolume    Decimal  @default(0) @db.Decimal(36, 18)
  lifetimeFees      Decimal  @default(0) @db.Decimal(36, 18)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders       Order[]
  trades       Trade[]
  events       BotEvent[]
  performance  BotPerformanceSnapshot[]
  runs         BotRun[]    @relation("BotRuns")

  @@index([userId])
  @@index([status])
  @@index([symbol])
  @@index([userId, status])
  @@index([archivedAt])
}

// ─────────────────────────────────────────────────────
// Bot Runs (one row per Start→Stop execution session)
// ─────────────────────────────────────────────────────

enum BotRunStatus {
  RUNNING
  STOPPED
  ERROR
}

model BotRun {
  id          String       @id @default(cuid())
  botId       String
  bot         Bot          @relation("BotRuns", fields: [botId], references: [id], onDelete: Cascade)
  /** #1, #2, ... per-bot increment for human-readable run numbering. */
  runNumber   Int

  /** Snapshot of Bot.params at the moment Start was triggered (immutable). */
  paramsSnapshot     Json
  initialStartPrice  Decimal?  @db.Decimal(36, 18)

  status      BotRunStatus @default(RUNNING)
  startedAt   DateTime     @default(now())
  stoppedAt   DateTime?
  /** Why the run ended: user_stop / risk_limit / error / cycle_complete / engine_shutdown */
  stopReason  String?

  // Final stats snapshot — filled when status moves out of RUNNING.
  realizedPnl       Decimal  @default(0) @db.Decimal(36, 18)
  unrealizedAtStop  Decimal? @db.Decimal(36, 18)
  cyclesCompleted   Int      @default(0)
  tradesCount       Int      @default(0)
  volumeQuote       Decimal  @default(0) @db.Decimal(36, 18)
  fees              Decimal  @default(0) @db.Decimal(36, 18)
  maxDrawdownAbs    Decimal? @db.Decimal(36, 18)
  durationMs        BigInt?
  /** Optional error message when stopReason='error'. */
  errorMessage      String?

  // Back-reference for the active-run pointer (a BotRun is referenced as Bot.currentRun).
  currentForBot Bot? @relation("BotCurrentRun")

  trades  Trade[]
  events  BotEvent[]

  @@unique([botId, runNumber])
  @@index([botId, startedAt(sort: Desc)])
  @@index([status])
}

model BotEvent {
  id        String   @id @default(cuid())
  botId     String
  bot       Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  /** Optional reference to the specific run during which this event happened. */
  botRunId  String?
  botRun    BotRun?  @relation(fields: [botRunId], references: [id], onDelete: SetNull)
  type      String   // STARTED, STOPPED, ERROR, ORDER_PLACED, ORDER_FILLED, etc.
  message   String
  data      Json?
  createdAt DateTime @default(now())

  @@index([botId, createdAt(sort: Desc)])
  @@index([botRunId])
  @@index([type])
}

model BotPerformanceSnapshot {
  id              String   @id @default(cuid())
  botId           String
  bot             Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  snapshotAt      DateTime @default(now())
  equityQuote     Decimal  @db.Decimal(36, 18)
  realizedPnl     Decimal  @db.Decimal(36, 18)
  unrealizedPnl   Decimal  @db.Decimal(36, 18)
  drawdownPct     Decimal  @db.Decimal(10, 6)
  totalTrades     Int
  winningTrades   Int
  losingTrades    Int

  @@index([botId, snapshotAt(sort: Desc)])
}

// ─────────────────────────────────────────────────────
// Orders & Trades
// ─────────────────────────────────────────────────────

model Order {
  id              String      @id @default(cuid())
  botId           String
  bot             Bot         @relation(fields: [botId], references: [id], onDelete: Cascade)

  exchange        ExchangeName @default(BINANCE)
  symbol          String
  clientOrderId   String      @unique
  exchangeOrderId String?
  side            OrderSide
  type            OrderType   @default(LIMIT)
  status          OrderStatus @default(NEW)

  price           Decimal     @db.Decimal(36, 18)
  quantity        Decimal     @db.Decimal(36, 18)
  filledQuantity  Decimal     @default(0) @db.Decimal(36, 18)
  cumulativeQuote Decimal     @default(0) @db.Decimal(36, 18)

  gridLevel       Int?
  meta            Json?

  placedAt        DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  filledAt        DateTime?
  canceledAt      DateTime?

  trades Trade[]

  @@index([botId, status])
  @@index([exchangeOrderId])
  @@index([symbol, status])
  @@index([placedAt])
}

model Trade {
  id              String   @id @default(cuid())
  botId           String
  bot             Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  /** Optional reference to the specific run that produced this trade. */
  botRunId        String?
  botRun          BotRun?  @relation(fields: [botRunId], references: [id], onDelete: SetNull)
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  exchangeTradeId String
  symbol          String
  side            OrderSide
  price           Decimal  @db.Decimal(36, 18)
  quantity        Decimal  @db.Decimal(36, 18)
  quoteQuantity   Decimal  @db.Decimal(36, 18)
  commission      Decimal  @default(0) @db.Decimal(36, 18)
  commissionAsset String?
  isMaker         Boolean  @default(true)
  realizedPnl     Decimal? @db.Decimal(36, 18)

  executedAt      DateTime
  createdAt       DateTime @default(now())

  @@unique([exchangeTradeId, symbol])
  @@index([botId, executedAt(sort: Desc)])
  @@index([botRunId])
  @@index([symbol])
}

// ─────────────────────────────────────────────────────
// Subscriptions & Payments (CoinPayments)
// ─────────────────────────────────────────────────────

model Plan {
  id           String   @id @default(cuid())
  code         String   @unique // e.g., "free", "starter", "pro", "elite"
  name         String
  description  String?
  priceUsd     Decimal  @db.Decimal(12, 2)
  billingCycleDays Int  @default(30)
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)

  // Limits
  maxBots          Int @default(1)
  maxApiKeys       Int @default(1)
  maxCustomStrategies Int @default(0)
  features         Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId    String
  plan      Plan               @relation(fields: [planId], references: [id])

  status         SubscriptionStatus @default(TRIAL)
  startsAt       DateTime           @default(now())
  endsAt         DateTime
  canceledAt     DateTime?
  autoRenew      Boolean            @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments Payment[]

  @@index([userId, status])
  @@index([endsAt])
}

model Payment {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionId  String?
  subscription    Subscription? @relation(fields: [subscriptionId], references: [id])

  provider        String        @default("coinpayments")
  providerTxnId   String?       @unique
  amountUsd       Decimal       @db.Decimal(12, 2)
  amountCrypto    Decimal?      @db.Decimal(36, 18)
  cryptoCurrency  String?
  status          PaymentStatus @default(PENDING)
  ipnRaw          Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  paidAt    DateTime?

  @@index([userId])
  @@index([status])
}

// ─────────────────────────────────────────────────────
// Notifications
// ─────────────────────────────────────────────────────

model NotificationPreference {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel   NotificationChannel
  eventType String
  enabled   Boolean             @default(true)
  config    Json?

  @@unique([userId, channel, eventType])
}

model NotificationLog {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel   NotificationChannel
  eventType String
  payload   Json
  success   Boolean
  error     String?
  createdAt DateTime            @default(now())

  @@index([userId, createdAt(sort: Desc)])
}

// ─────────────────────────────────────────────────────
// Logging & Audit
// ─────────────────────────────────────────────────────

model SystemLog {
  id        String      @id @default(cuid())
  level     LogLevel
  category  LogCategory
  message   String
  data      Json?
  userId    String?
  user      User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  botId     String?
  requestId String?
  service   String?
  createdAt DateTime    @default(now())

  @@index([level])
  @@index([category])
  @@index([createdAt(sort: Desc)])
  @@index([userId])
  @@index([botId])
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  actorType   String   // USER, ADMIN, SYSTEM
  action      String   // e.g., "bot.create", "user.login", "api_key.delete"
  targetType  String?
  targetId    String?
  ipAddress   String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([action])
  @@index([targetType, targetId])
}

model BinanceApiCallLog {
  id           String   @id @default(cuid())
  endpoint     String
  method       String
  statusCode   Int?
  durationMs   Int?
  weightUsed   Int?
  apiKeyId     String?
  botId        String?
  errorCode    Int?
  errorMessage String?
  requestData  Json?
  responseData Json?
  createdAt    DateTime @default(now())

  @@index([apiKeyId, createdAt(sort: Desc)])
  @@index([endpoint])
  @@index([statusCode])
}

// ─────────────────────────────────────────────────────
// Platform Settings (Admin-tunable)
// ─────────────────────────────────────────────────────

model AppSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  category  String?
  isPublic  Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@index([category])
}

model FeatureFlag {
  id           String   @id @default(cuid())
  key          String   @unique
  enabled      Boolean  @default(false)
  description  String?
  rolloutPct   Int      @default(0)
  // Optional list of userIds to specifically include
  allowList    String[]
  /**
   * Advanced targeting rules (JSON). Recognized keys:
   *   roles?: ('USER' | 'PRO' | 'ADMIN' | 'SUPER_ADMIN')[]
   *   plans?: string[]            // plan codes (e.g. ['pro', 'elite'])
   *   countries?: string[]        // ISO-2 codes
   *   signupAfter?: string        // ISO date — only users created after
   *   signupBefore?: string       // ISO date
   *   minBots?: number
   *   trialOnly?: boolean
   * Empty object = no targeting (rolloutPct + allowList still apply).
   */
  targeting    Json     @default("{}")
  updatedAt    DateTime @updatedAt
}

// ─────────────────────────────────────────────────────
// Wallet — portfolio snapshots & price alerts
// ─────────────────────────────────────────────────────

model PortfolioSnapshot {
  id              String   @id @default(cuid())
  apiKeyId        String
  apiKey          ExchangeApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalValueUsd   Decimal  @db.Decimal(24, 8)
  assetCount      Int
  /** Per-asset breakdown {asset: total, value} */
  breakdown       Json
  createdAt       DateTime @default(now())

  @@index([apiKeyId, createdAt(sort: Desc)])
  @@index([userId])
}

model PriceAlert {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  symbol      String   // e.g. "BTCFDUSD"
  asset       String   // user-facing asset name, e.g. "BTC"
  /** ABOVE = trigger when market >= threshold; BELOW = trigger when market <= threshold. */
  direction   String
  threshold   Decimal  @db.Decimal(24, 8)
  /** Notes the user can attach (e.g. "buy zone", "stop loss target"). */
  note        String?
  enabled     Boolean  @default(true)
  triggeredAt DateTime?
  triggeredPrice Decimal? @db.Decimal(24, 8)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, enabled])
  @@index([symbol])
}

// ─────────────────────────────────────────────────────
// Coupons & Redemptions (Sprint 4)
// ─────────────────────────────────────────────────────

model Coupon {
  id              String   @id @default(cuid())
  code            String   @unique
  description     String?
  /** PERCENT (0..100) or FIXED amount in USD. */
  discountType    String   // 'PERCENT' | 'FIXED'
  discountValue   Decimal  @db.Decimal(12, 2)
  /** Optional plan codes the coupon applies to. Empty = any plan. */
  applicablePlans String[]
  maxRedemptions  Int?     // null = unlimited
  perUserLimit    Int      @default(1)
  validFrom       DateTime @default(now())
  validUntil      DateTime?
  isActive        Boolean  @default(true)
  redemptionCount Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  redemptions CouponRedemption[]

  @@index([isActive])
  @@index([validUntil])
}

model CouponRedemption {
  id         String   @id @default(cuid())
  couponId   String
  coupon     Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentId  String?  // optional link to the payment that applied it
  amountOff  Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now())

  @@index([couponId])
  @@index([userId])
  @@unique([couponId, userId, createdAt])
}

// ─────────────────────────────────────────────────────
// Email templates (Sprint 4)
// ─────────────────────────────────────────────────────

model EmailTemplate {
  id          String   @id @default(cuid())
  key         String   @unique   // e.g. 'welcome', 'trial_ending', 'payment_failed'
  name        String
  subject     String
  body        String              // markdown / HTML
  variables   String[]            // declared variables like ['name', 'planCode']
  isActive    Boolean  @default(true)
  description String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

// ─────────────────────────────────────────────────────
// NPS / Feedback surveys (Sprint 4)
// ─────────────────────────────────────────────────────

model SurveyResponse {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  surveyKey String   @default("nps")  // 'nps' | 'churn_reason' | custom
  score     Int?     // 0..10 for NPS
  category  String?  // 'promoter' | 'passive' | 'detractor' (auto-computed for NPS)
  comment   String?
  metadata  Json?

  createdAt DateTime @default(now())

  @@index([surveyKey, createdAt(sort: Desc)])
  @@index([userId])
}

// ─────────────────────────────────────────────────────
// Two-Person Approvals (Sprint 4)
// ─────────────────────────────────────────────────────

model PendingApproval {
  id              String   @id @default(cuid())
  /** What action requires approval (e.g. 'payment.refund', 'user.role.change') */
  action          String
  /** Target type/id for the action */
  targetType      String?
  targetId        String?
  /** Action payload — replayed when approved */
  payload         Json
  /** Who requested the action */
  requestedBy     String
  requestedByUser User     @relation("ApprovalRequester", fields: [requestedBy], references: [id], onDelete: Cascade)
  reason          String?
  /** Who approved (must differ from requestedBy) */
  approvedBy      String?
  approvedAt      DateTime?
  /** Set if rejected */
  rejectedBy      String?
  rejectedAt      DateTime?
  rejectionReason String?
  /** Set after the approved action was successfully replayed */
  executedAt      DateTime?
  executionResult Json?
  /** Auto-expires after a TTL (default 24h) */
  expiresAt       DateTime
  createdAt       DateTime @default(now())

  @@index([action])
  @@index([requestedBy])
  @@index([expiresAt])
  @@index([approvedAt])
}

// ─────────────────────────────────────────────────────
// Exchange metadata cache (symbols, filters)
// ─────────────────────────────────────────────────────

model ExchangeSymbol {
  id              String       @id @default(cuid())
  exchange        ExchangeName @default(BINANCE)
  symbol          String
  baseAsset       String
  quoteAsset      String
  status          String
  baseAssetPrecision  Int
  quoteAssetPrecision Int
  tickSize        Decimal      @db.Decimal(36, 18)
  stepSize        Decimal      @db.Decimal(36, 18)
  minNotional     Decimal      @db.Decimal(36, 18)
  minQty          Decimal      @db.Decimal(36, 18)
  maxQty          Decimal      @db.Decimal(36, 18)
  isSpotTradingAllowed Boolean @default(true)
  rawFilters      Json
  updatedAt       DateTime     @updatedAt

  @@unique([exchange, symbol])
  @@index([quoteAsset])
}
