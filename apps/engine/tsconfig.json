{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "target": "ES2022",
    "useDefineForClassFields": false,
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": false,
    "declarationMap": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noUncheckedIndexedAccess": false
  },
  "include": ["src/**/*"]
}
